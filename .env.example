# Vighnaharta HealthNova Environment Configuration Example
# Public variables exposed to frontend must start with VITE_
# DO NOT add secret API keys or database connection strings to frontend env files.

VITE_API_BASE_URL=https://api.vighnahartahealthnova.com/v1
VITE_API_TIMEOUT=15000
VITE_ENABLE_MOCK_FALLBACK=true
VITE_APP_ENV=development
